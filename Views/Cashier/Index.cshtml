
@model IEnumerable<QuickPOS.Models.Product>

@{
    ViewData["Title"] = "Cashier";
}

<div class="cashier-page">

    <div class="cashier-heading">
        <div>
            <h2>Cashier Terminal</h2>
            <p>Select products, build an order, and check out.</p>
        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-secondary">
            Manage Products
        </a>
    </div>

        <div id="checkoutSuccess"
            class="alert alert-success alert-dismissible fade show shadow-sm"
            role="alert"
            style="display: none; border-radius: 12px; margin-bottom: 20px;">

            <span id="successMessage">
                Checkout complete!
            </span>

            <button type="button"
                    class="btn-close"
                    onclick="closeSuccessMessage()">
            </button>
        </div>

    <div class="row cashier-layout">

        <div class="col-lg-7">
            <div class="card cashier-card">

                <div class="catalog-heading">
                    <div>
                        <h4>Product Catalog</h4>
                        <p>Available items and current stock</p>
                    </div>

                    <a asp-controller="Products"
                       asp-action="Create"
                       class="btn btn-primary">
                        + Add Product
                    </a>
                </div>

                <input type="text"
                       id="searchProduct"
                       class="form-control search-box"
                       placeholder="Search products or categories..." />

                <div class="row" id="productList">

                    @foreach (var product in Model)
                    {
                        <div class="col-md-6 mb-3 product-item"
                             data-name="@product.Name.ToLower()"
                             data-category="@product.Category.ToLower()">

                            <div class="product-card">

                                <div class="product-info">
                                    <span class="category-label">
                                        @product.Category
                                    </span>

                                    <span class="stock-label">
                                        @product.Stock in stock
                                    </span>
                                </div>

                                <h5>@product.Name</h5>

                                <h4 class="product-price">
                                    ₱@product.Price.ToString("0.00")
                                </h4>

                                <div class="product-actions">

                                    <input type="number"
                                           class="form-control quantity-input"
                                           value="1"
                                           min="1"
                                           max="@product.Stock" />

                                    <button class="btn btn-primary add-cart"
                                            data-id="@product.Id"
                                            data-name="@product.Name"
                                            data-price="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-stock="@product.Stock"
                                            disabled="@(product.Stock <= 0)">
                                        + Add to Cart
                                    </button>

                                </div>

                            </div>
                        </div>
                    }

                </div>

                <p id="noProducts" class="text-muted" style="display:none;">
                    No products found.
                </p>

            </div>
        </div>

        <div class="col-lg-5">
            <div class="card cashier-card cart-card">

                <div class="cart-heading">
                    <div>
                        <h4>Current Order</h4>
                        <p><span id="cartCount">0</span> item(s) in cart</p>
                    </div>

                    <span class="cart-icon">🛒</span>
                </div>

                <div id="cartItems">
                    <p class="empty-cart">Your cart is empty.</p>
                </div>

                <hr />

                <div class="total-section">
                    <span>Order Total</span>
                    <h3>₱<span id="total">0.00</span></h3>
                </div>

                <button class="btn btn-success checkout-button"
                        id="checkout">
                    ✓ Complete Checkout
                </button>

                <button class="btn btn-secondary clear-button"
                        id="clearCart">
                    × Clear Cart
                </button>

            </div>
        </div>

    </div>

</div>


<script>
    var cart = [];

    var buttons = document.querySelectorAll(".add-cart");

    buttons.forEach(function(button) {

        button.addEventListener("click", function() {

            var id = this.dataset.id;
            var name = this.dataset.name;
            var price = parseFloat(this.dataset.price);
            var stock = parseInt(this.dataset.stock);

            var quantityInput = this.parentElement.querySelector(".quantity-input");
            var quantity = parseInt(quantityInput.value);

            if (quantity < 1 || isNaN(quantity)) {
                alert("Please enter a valid quantity.");
                return;
            }

            var item = cart.find(function(product) {
                return product.id === id;
            });

            if (item) {

                if (item.quantity + quantity <= stock) {
                    item.quantity += quantity;
                } else {
                    alert("Not enough stock!");
                }

            } else {

                if (quantity <= stock) {
                    cart.push({
                        id: id,
                        name: name,
                        price: price,
                        quantity: quantity,
                        stock: stock
                    });
                } else {
                    alert("Not enough stock!");
                }

            }

            displayCart();
        });

    });

    // Display shopping cart
    function displayCart() {

        var cartItems = document.getElementById("cartItems");
        var total = 0;
        var count = 0;

        cartItems.innerHTML = "";

        if (cart.length === 0) {

            cartItems.innerHTML = "<p class='empty-cart'>Your cart is empty.</p>";

        }

        cart.forEach(function(item, index) {

            var subtotal = item.price * item.quantity;

            total += subtotal;
            count += item.quantity;

            var div = document.createElement("div");
            div.className = "cart-item";

            var details = document.createElement("div");
            details.className = "cart-details";

            var name = document.createElement("h6");
            name.textContent = item.name;

            var price = document.createElement("p");
            price.textContent = "₱" + item.price.toFixed(2) + " each";

            details.appendChild(name);
            details.appendChild(price);

            var actions = document.createElement("div");
            actions.className = "cart-actions";

            var quantity = document.createElement("input");
            quantity.type = "number";
            quantity.min = "1";
            quantity.max = item.stock;
            quantity.value = item.quantity;
            quantity.className = "form-control cart-quantity";

            quantity.addEventListener("change", function() {

                var newQuantity = parseInt(this.value);

                if (newQuantity < 1 || isNaN(newQuantity)) {
                    item.quantity = 1;
                } else if (newQuantity > item.stock) {
                    alert("Not enough stock!");
                    item.quantity = item.stock;
                } else {
                    item.quantity = newQuantity;
                }

                displayCart();
            });

            var subtotalText = document.createElement("strong");
            subtotalText.textContent = "₱" + subtotal.toFixed(2);

            var removeButton = document.createElement("button");
            removeButton.textContent = "Remove";
            removeButton.className = "btn btn-danger btn-sm";

            removeButton.addEventListener("click", function() {
                cart.splice(index, 1);
                displayCart();
            });

            actions.appendChild(quantity);
            actions.appendChild(subtotalText);
            actions.appendChild(removeButton);

            div.appendChild(details);
            div.appendChild(actions);

            cartItems.appendChild(div);

        });

        document.getElementById("total").textContent = total.toFixed(2);
        document.getElementById("cartCount").textContent = count;

    }

    document.getElementById("searchProduct").addEventListener("input", function() {

        var search = this.value.toLowerCase();
        var products = document.querySelectorAll(".product-item");
        var visibleCount = 0;

        products.forEach(function(product) {

            var name = product.dataset.name;
            var category = product.dataset.category;

            if (name.includes(search) || category.includes(search)) {
                product.style.display = "";
                visibleCount++;
            } else {
                product.style.display = "none";
            }

        });

        document.getElementById("noProducts").style.display =
            visibleCount === 0 ? "block" : "none";

    });


    document.getElementById("clearCart").addEventListener("click", function() {

        cart = [];
        displayCart();

    });

        document.getElementById("checkout").addEventListener("click", function() {

            if (cart.length === 0) {
                alert("Your cart is empty!");
                return;
            }

            var checkoutTotal = document.getElementById("total").textContent;

            document.getElementById("successMessage").textContent =
                "Checkout complete. Demo sale total: ₱" +
                checkoutTotal + ".";

            document.getElementById("checkoutSuccess").style.display = "block";

            cart = [];
            displayCart();

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });

        });

        function closeSuccessMessage() {
            document.getElementById("checkoutSuccess").style.display = "none";
        }

</script>
