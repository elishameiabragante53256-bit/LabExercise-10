
@model QuickPOS.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="product-form-page">

    <div class="product-form-container">

        <a asp-action="Index" class="back-products-btn">
            <span>▦</span> Back to products
        </a>

        <div class="form-heading">
            <h2>Add Product</h2>
            <p>Add an item to your POS catalog.</p>
        </div>

        <div class="product-form-card">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="form-group-custom">
                    <label asp-for="Name">Product name</label>
                    <input asp-for="Name"
                           class="form-control custom-input"
                           placeholder="Enter product name" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Category">Category</label>
                    <input asp-for="Category"
                           class="form-control custom-input"
                           placeholder="Enter category" />
                    <span asp-validation-for="Category"
                          class="text-danger"></span>
                </div>

                <div class="form-row-custom">

                    <div class="form-group-custom">
                        <label asp-for="Price">Price</label>

                        <div class="price-input">
                            <span>₱</span>
                            <input asp-for="Price"
                                   class="form-control custom-input"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   placeholder="0.00" />
                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Stock">Stock</label>
                        <input asp-for="Stock"
                               class="form-control custom-input"
                               type="number"
                               min="0"
                               placeholder="Enter stock quantity" />
                        <span asp-validation-for="Stock"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="form-buttons">

                    <button type="submit" class="save-product-btn">
                        ✓ Save Product
                    </button>

                    <a asp-action="Index" class="cancel-product-btn">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
